{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Current study: inspect published results",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/inspect_results.py",
        "--verify"
      ],
      "options": {
        "cwd": "${workspaceFolder}/studies/insider_reactions_v3"
      },
      "problemMatcher": []
    },
    {
      "label": "Current study: test controls",
      "type": "process",
      "command": "python3",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}/studies/insider_reactions_v3"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Current study: inspect local run",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/inspect_results.py",
        "--output",
        "${input:currentStudyRunFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/studies/insider_reactions_v3"
      },
      "problemMatcher": []
    },
    {
      "label": "Current study: run new replication",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/run.py",
        "--output",
        "${input:currentStudyRunFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/studies/insider_reactions_v3"
      },
      "problemMatcher": []
    },
    {
      "label": "Legacy: Check Ollama and Llama 3",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "trusted_lab",
        "doctor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Legacy: Check trusted prompt variants",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "trusted_lab",
        "prompt-check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Legacy: Run local smoke test",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "trusted_lab",
        "smoke"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Legacy: Run all five approaches with mock fixture",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "trusted_lab",
        "run",
        "--backend",
        "mock"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Legacy: Run pilot on Llama 3",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "trusted_lab",
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Legacy: Test experimental controls",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Legacy: Run oligopoly market pilot",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "trusted_lab.market",
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Legacy: Calibrate oligopoly formation",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "trusted_lab.market",
        "run",
        "--formation-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Legacy: Plan eight Groq conditions",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "trusted_lab.cournot",
        "plan"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Legacy: Check Groq key configuration",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "trusted_lab.cournot",
        "doctor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Legacy: Run Groq cartel formation only",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "trusted_lab.cournot",
        "run",
        "--formation-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Legacy: Run eight Groq investigator conditions",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "trusted_lab.cournot",
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Legacy: Queue all eight Groq conditions (saved run)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "tools/batch_cournot.py",
        "start",
        "--output",
        "${input:cournotRunFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "currentStudyRunFolder",
      "type": "promptString",
      "description": "Local run folder relative to studies/insider_reactions_v3; use a NEW directory for a new replication, never artifacts/final_16",
      "default": "results/replication_01"
    },
    {
      "id": "cournotRunFolder",
      "type": "promptString",
      "description": "Saved Groq run directory (for example results/cournot_...)"
    }
  ]
}
