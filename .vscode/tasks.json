{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Current study: inspect published results",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/inspect_results.py",
        "--verify"
      ],
      "options": {
        "cwd": "${workspaceFolder}/studies/exp 2 (insider_reactions_v3)"
      },
      "problemMatcher": []
    },
    {
      "label": "Current study: test controls",
      "type": "process",
      "command": "python3",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}/studies/exp 2 (insider_reactions_v3)"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Current study: inspect local run",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/inspect_results.py",
        "--output",
        "${input:currentStudyRunFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/studies/exp 2 (insider_reactions_v3)"
      },
      "problemMatcher": []
    },
    {
      "label": "Current study: run new replication",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/run.py",
        "--output",
        "${input:currentStudyRunFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/studies/exp 2 (insider_reactions_v3)"
      },
      "problemMatcher": []
    },
    {
      "label": "Environment 2: test market and protocol",
      "type": "process",
      "command": "python3",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}/environments/env 2 (differentiated_prices)"
      },
      "problemMatcher": []
    },
    {
      "label": "Environment 2: validate economic benchmarks",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/validate.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}/environments/env 2 (differentiated_prices)"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "currentStudyRunFolder",
      "type": "promptString",
      "description": "Local run folder relative to studies/exp 2 (insider_reactions_v3); use a NEW directory for a new replication, never artifacts/final_16",
      "default": "results/replication_01"
    }
  ]
}
